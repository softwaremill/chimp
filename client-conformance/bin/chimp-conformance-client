#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="${CHIMP_CLIENT_CONFORMANCE_JAR:-}"
if [[ -z "${JAR}" ]]; then
  for candidate in "${DIR}"/../target/scala-*/chimp-client-conformance.jar; do
    [[ -f "${candidate}" ]] && JAR="${candidate}"
  done
fi
if [[ -z "${JAR}" || ! -f "${JAR}" ]]; then
  echo "Fat jar not found. Run 'sbt clientConformance/assembly' first, or set CHIMP_CLIENT_CONFORMANCE_JAR." >&2
  exit 127
fi
exec java -jar "${JAR}" "$@"
